# ============================================================
# ビルド出力
# ============================================================
# CMakePresets.json の binaryDir（build/<preset名>）
/build/
# Visual Studio の「フォルダーを開く」が使う既定の出力先
/out/
# CLion の既定の出力先
cmake-build-*/

# ============================================================
# CMake
# ============================================================
# 個人用のプリセット（共有するプリセットは CMakePresets.json に書く）
CMakeUserPresets.json
# ソースディレクトリ内で誤って cmake を実行した場合の生成物
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
# clangd 用にビルドディレクトリからコピー / リンクしたもの
compile_commands.json

# ============================================================
# vcpkg
# ============================================================
# マニフェストモードでソースディレクトリ直下に作られる場合がある
vcpkg_installed/

# ============================================================
# コンパイル・リンクの生成物（ビルドディレクトリ外に出た場合の保険）
# ============================================================
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.gch

# ============================================================
# 実行時の生成物
# ============================================================
# クラッシュダンプ
*.dmp
core
core.*
# カバレッジ・プロファイル（LLVM / GCC）
*.profraw
*.profdata
*.gcda
*.gcno
# ログ
*.log
# ゲームの録画・リプレイなどの一時出力
/captures/

# ============================================================
# エディタ・IDE
# ============================================================
# Visual Studio
.vs/
*.user
*.suo
# Visual Studio Code（共有したい設定ができたら除外を解除する）
.vscode/
*.code-workspace
# JetBrains (CLion / Rider)
.idea/
# clangd のインデックス
.cache/
# Vim / Emacs
*.swp
*~
\#*\#

